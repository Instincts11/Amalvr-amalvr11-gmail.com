      "createdBy": "usr_globex_owner"
    }
  ],

  "sessions": [
    {
      "id": "ses_live_build_server",
      "orgId": "org_acme",
      "userId": "usr_sam",
      "deviceId": "dev_build_server_01",
      "mode": "control",
      "state": "active",
