  "_grantsNote": [
    "Four grants, each seeded to demonstrate a different rule. Together they cover the whole",
    "resolution algorithm, so a candidate can see every rule in the UI on first boot.",
    "",
    "  1. D3 + D6  grant WIDENS past the role, scoped to ONE device",
    "  2. D1 + D4  explicit DENY narrows the role, scoped to one device",
    "  3. D1       org-wide DENY beats the role baseline everywhere in the org",
    "  4. D6       device-scoped grant: unlocked on exactly one row, locked on all the others"
  ],
  "grants": [
    {
      "id": "grt_viewer_start_session",
      "orgId": "org_acme",
      "userId": "usr_acme_viewer",
      "deviceId": "dev_lab_mac_01",
      "effect": "allow",
      "permissions": ["session:start", "device:view"],
      "createdBy": "usr_acme_owner",
      "_demonstrates": "D3 + D6 — a viewer cannot start sessions by role, but can on THIS device only. Because mode=view needs session:start + device:view, they get a working View button on lab-mac-01 and nowhere else."
    },
    {
      "id": "grt_viewer_deny_kiosk",
      "orgId": "org_acme",
      "userId": "usr_acme_viewer",
      "deviceId": "dev_kiosk_lobby_01",
      "effect": "deny",
      "permissions": ["device:view"],
      "createdBy": "usr_acme_owner",
      "_demonstrates": "D1 + D4 — the role grants device:view, this deny removes it. Per PERMISSIONS.md §2, denying device:view removes the row from the list entirely, so kiosk-lobby-01 does not appear for this user at all."
    },
    {
      "id": "grt_sam_deny_terminal_orgwide",
      "orgId": "org_acme",
      "userId": "usr_sam",
      "deviceId": null,
      "effect": "deny",
      "permissions": ["device:terminal"],
      "createdBy": "usr_acme_owner",
      "_demonstrates": "D1 — operator's baseline includes device:terminal; this org-wide deny removes it everywhere in Acme. Sam can still control devices; she just cannot open a shell. Vector 7 in PERMISSIONS.md §11: an org-wide deny is NOT carved out by any device-scoped allow."
    },
    {
      "id": "grt_dana_control_one_device",
      "orgId": "org_globex",
      "userId": "usr_dana",
      "deviceId": "dev_globex_desk_01",
      "effect": "allow",
      "permissions": ["device:control"],
      "createdBy": "usr_globex_owner",
      "_demonstrates": "D6 — Dana is a viewer in Globex, so Control is locked on every row EXCEPT this one. The clearest single demonstration that authorization is device-scoped rather than org-level."
    },
    {
      "id": "grt_lea_deny_terminal",
      "orgId": "org_globex",
      "userId": "usr_globex_lea",
      "deviceId": null,
      "effect": "deny",
      "permissions": ["device:terminal"],
      "createdBy": "usr_globex_owner"
    },
    {
      "id": "grt_noah_desk_control",
      "orgId": "org_globex",
      "userId": "usr_globex_noah",
      "deviceId": "dev_globex_desk_01",
      "effect": "allow",
      "permissions": ["device:control"],
      "createdBy": "usr_globex_owner"
    },
    {
      "id": "grt_priya_deny_list",
      "orgId": "org_globex",
      "userId": "usr_globex_priya",
      "deviceId": null,
      "effect": "deny",
      "permissions": ["device:list"],
      "createdBy": "usr_globex_owner"
    },
    {
      "id": "grt_jules_file",
      "orgId": "org_globex",
      "userId": "usr_globex_jules",
      "deviceId": null,
      "effect": "allow",
      "permissions": ["device:file_transfer"],
